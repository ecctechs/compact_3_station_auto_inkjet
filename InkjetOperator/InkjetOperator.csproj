<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Rendering configuration (Phase 1). ApplicationConfiguration.Initialize() in
      Program.cs reads these three properties; they are the only supported way to
      set them, because AntdUI.Config.Font is [Obsolete] in AntdUI 2.4.3.

      ApplicationHighDpiMode: the app previously declared no DPI awareness at all,
      so Windows rendered it at 96 DPI and bitmap-stretched the result on every
      display scaled above 100% - that is what made text and borders look soft.
      PerMonitorV2 makes it render at the monitor's real DPI instead.

      ApplicationDefaultFont: pins the font that controls without an explicit Font
      inherit. Segoe UI 9pt is what Control.DefaultFont already resolved to here,
      so this changes nothing visually - it only stops the default from following
      the machine's UI language (a th-TH machine resolves a different face).
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>

    <!-- ไอคอนของ .exe — ไฟล์เดียวเก็บหลายขนาดไว้ 16 ถึง 256 เพราะ Windows
         หยิบไปใช้คนละขนาดตามที่ ทั้งแถบงาน มุมหน้าต่าง Alt-Tab และในโฟลเดอร์ -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!--
      AntdUI-main\ and NastoKeyence\ are reference checkouts that happen to sit
      inside this project's folder. An SDK-style project globs **/*.cs, so without
      this both trees are compiled into InkjetOperator (2456 errors: duplicate
      assembly attributes, unsafe code, missing xunit/DI references). AntdUI itself
      is consumed through the NuGet package below, not from AntdUI-main\.

      Remove these two entries if the folders are ever moved out of InkjetOperator\.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);AntdUI-main\**;NastoKeyence\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.3" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Setting.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
