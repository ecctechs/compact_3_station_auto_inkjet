<!--
  ค่าตั้งต้นสำหรับเครื่องที่ยังไม่เคยตั้งค่า — ไม่ใช่ไฟล์ที่โปรแกรมใช้งานจริง

  ไฟล์ที่ใช้งานจริงคือ C:\ProgramData\CompactInkjet\Setting.config ซึ่งโปรแกรม
  สร้างขึ้นเองครั้งแรกที่เปิด โดยลอกค่าจากไฟล์นี้ไปตั้งต้น หลังจากนั้นไฟล์นี้
  ไม่มีผลอะไรอีกเลย แก้ค่าหน้างานให้แก้ที่หน้า Setting ในโปรแกรม

  ห้ามเปลี่ยนชื่อไฟล์นี้กลับเป็น Setting.config — ชื่อเดิมทำให้มีไฟล์ชื่อเดียวกัน
  สองตัวในเครื่อง ตัวหนึ่งข้าง ๆ .exe อีกตัวใน ProgramData แล้วเข้าใจกันว่า
  CopyToOutputDirectory=PreserveNewest จะไม่ทับตัวที่แก้ไว้ ซึ่งไม่จริง
  MSBuild เทียบว่า "ขนาดกับเวลาตรงกันไหม" ไม่ใช่ "ปลายทางใหม่กว่าไหม"
  พอ git checkout เขียนไฟล์ต้นทางใหม่ เวลาก็ไม่ตรง แล้วมันก๊อปทับทันที
  ค่าที่ตั้งไว้ทั้งไฟล์หายเหลือเท่าที่เห็นข้างล่างนี้
-->
<configuration>
  <appSettings>
    <add key="MENU_LEVEL" value="99" />
    <add key="PLC_PASSWORD" value="1234" />
  </appSettings>
</configuration>
