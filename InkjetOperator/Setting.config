<configuration>
  <appSettings>
    <!-- ค่าเริ่มต้นกลาง ๆ สำหรับ repo เท่านั้น -->
    <!-- ค่าจริงของแต่ละเครื่องให้แก้ที่ Setting.config ในโฟลเดอร์ bin ข้าง ๆ ตัว .exe -->
    <!-- ไฟล์ใน bin ที่ถูกแก้จะใหม่กว่าไฟล์นี้ CopyToOutputDirectory=PreserveNewest จึงไม่ทับ -->

    <!-- ระดับเมนู: 0=Input Order+Setting, 1=Order List+Edit Pattern+Setting,
         9=Setting อย่างเดียว (ทดสอบหน้างาน: PLC/Clamp/UV Test), อื่น ๆ=ครบทุกเมนู -->
    <add key="MENU_LEVEL" value="1" />

    <!-- ฐานข้อมูล -->
    <add key="DB_PATH" value="" />
    <add key="CLAMP_DB_PATH" value="" />

    <!-- Backend -->
    <add key="PC_IP" value="127.0.0.1" />
    <add key="PC2IP_NAME" value="PC" />

    <!-- หัวพิมพ์อิงค์เจ็ท (RS-232) -->
    <add key="MK058_COM" value="" />
    <add key="MK058_BAUD" value="9600" />
    <add key="MK058_NAME" value="MK-058" />
    <add key="MK059_COM" value="" />
    <add key="MK059_BAUD" value="9600" />
    <add key="MK059_NAME" value="MK-059" />
    <add key="MK060_COM" value="" />
    <add key="MK060_BAUD" value="9600" />
    <add key="MK061_COM" value="" />
    <add key="MK061_BAUD" value="9600" />

    <!-- UV -->
    <add key="UV001_IP" value="" />
    <add key="UV001_PORT" value="10086" />
    <add key="UV002_IP" value="" />
    <add key="UV002_PORT" value="10086" />

    <!-- PLC -->
    <add key="PLC_IP" value="" />
    <add key="PLC_PORT" value="502" />
    <add key="PLC_NAME" value="PLC-001" />
    <add key="PLC_PASSWORD" value="1234" />

    <!-- Clamp -->
    <add key="CLAMP_PLC_IP" value="" />
    <add key="CLAMP_PLC_PORT" value="5012" />
    <add key="CLAMP_ADDR_TARGET" value="D216" />
    <add key="CLAMP_ADDR_RUN" value="M700" />
    <add key="CLAMP_ADDR_RESET" value="M701" />
    <add key="CLAMP_ADDR_STATUS" value="W38" />

    <!-- รูปอ้างอิงการพิมพ์ -->
    <add key="MARKING_REF_FOLDER" value="" />
  </appSettings>
</configuration>
